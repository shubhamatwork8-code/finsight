# Default local database. For PostgreSQL, start docker compose from the repo root
# and switch DATABASE_URL to the postgres URL below.
DATABASE_URL=sqlite:///./data/finsight.db
# DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:5432/finsight
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=dev-only-change-before-deploy
DEMO_PASSWORD=FinSight-demo-1
